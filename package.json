{
  "name": "tienda-curso-full-stack",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación Full Stack unificada (React + Vite + Express + MySQL) para la tienda L&D™ Streetwear & Footwear",
  "type": "module",
  "main": "server/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/seed.js",
    "db:setup": "node server/db/init.js --seed",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "node-sql-parser": "^5.4.0"
  }
}
